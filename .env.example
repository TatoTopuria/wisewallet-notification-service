# Spring profile (local | dev | prod)
SPRING_PROFILES_ACTIVE=local

# Database
DB_HOST=localhost
DB_PORT=5435
DB_NAME=notification_db
DB_USERNAME=postgres
DB_PASSWORD=dev_password

# Internal API key (must match account-service and transaction-service)
INTERNAL_API_KEY=dev-internal-key

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Account service
ACCOUNT_SERVICE_URL=http://localhost:8081

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wisewallet-notifications

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
